# Policy server and trainer: LeRobot (SmolVLA, ACT, pi0/pi0.5 ports, ...) + panda_al.policy.serve + dataset export.
# Runs on any CUDA GPU (no RT cores needed), e.g. the H100 server. `./al.sh build policy`, `./al.sh serve ...`.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg && rm -rf /var/lib/apt/lists/*

ARG LEROBOT_VERSION=0.6.1
# smolvla: the model; training: datasets, video decoding, accelerate, wandb (fine-tuning on our episodes)
RUN pip install --no-cache-dir "lerobot[smolvla,training]==${LEROBOT_VERSION}"

WORKDIR /workspace/panda_cosmos_al
COPY pyproject.toml README.md ./
COPY src src
RUN pip install --no-cache-dir -e . pytest

ENTRYPOINT ["python", "-m", "panda_al.policy.serve"]
CMD ["--help"]
