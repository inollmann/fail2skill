# Defaults. Override per machine / user in docker/.env.local (not committed), e.g.
#   AL_GPU=1
#   AL_BRIDGE_PORT=45220
#   ROS_DOMAIN_ID=17

# Isaac Lab checkout used to build the isaac-lab-base image, pinned for reproducibility
ISAACLAB_PATH=../IsaacLab
ISAACLAB_REPO=https://github.com/isaac-sim/IsaacLab.git
ISAACLAB_REF=259e1a8cf
ISAACLAB_BASE_IMAGE=isaac-lab-base:latest

# multipanda_ros2 sources for the ROS image: a git URL (#branch) or an absolute path to a checkout
MULTIPANDA_CONTEXT=https://github.com/tenfoldpaper/multipanda_ros2.git#humble

# GPU index (as in nvidia-smi) for the containers started by this user
AL_GPU=0

# Host directory for recorded episodes (relative to docker/ or absolute)
AL_DATA=../data

# On a shared machine give every user their own port and ROS domain
AL_BRIDGE_PORT=45210
ROS_DOMAIN_ID=42

# Policy server that ./al.sh policy connects to (openpi's serve_policy.py or ./al.sh serve / the policy-lerobot service)
AL_POLICY_HOST=127.0.0.1
AL_POLICY_PORT=8000

AL_IMAGE_TAG=latest
